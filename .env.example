# ---------------------------------------------------------------------------
# NexSwap local environment template
# Copy this file to backend/.env and frontend/.env (or export the values).
# Never commit real credentials or secrets.
# ---------------------------------------------------------------------------

# Backend
SERVER_PORT="8080"
DB_URL="jdbc:mysql://localhost:3306/nexswap?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true"
DB_USERNAME="nexswap"
DB_PASSWORD="change-me"
JWT_SECRET="replace-with-a-random-string-at-least-32-characters-long"
JWT_EXPIRATION_MS="86400000"
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
UPLOAD_DIR="uploads"

# Optional bootstrap administrator (created only when both values are present)
ADMIN_NAME="NexSwap Administrator"
ADMIN_EMAIL="admin@nexswap.local"
ADMIN_PASSWORD="change-me-too"

# Optional demo catalogue seed (true/false). Keep disabled for a clean install.
SEED_DEMO_DATA="false"

# Frontend
VITE_API_URL="/api"
# Set this when the API is hosted on another origin, e.g. http://localhost:8080
# VITE_MEDIA_URL=http://localhost:8080
