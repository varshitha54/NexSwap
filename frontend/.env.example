# Relative /api uses the Vite dev proxy. For a deployed API use an absolute URL,
# for example VITE_API_URL=https://api.nexswap.example/api
VITE_API_URL=/api

# Optional: backend origin used for uploaded cover images when the frontend and
# backend are served from different origins.
# VITE_MEDIA_URL=https://api.nexswap.example
